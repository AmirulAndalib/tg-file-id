{
	"compilerOptions": {
		"strict": true,
		"module": "Node16",
		"target": "es2020",
		"noImplicitAny": true,
		"declaration": true,
		"moduleResolution": "Node16",
		"sourceMap": true,
		"types": ["node"],
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
